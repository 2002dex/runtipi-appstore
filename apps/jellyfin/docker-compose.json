{
  "services": [
    {
      "name": "jellyfin",
      "image": "lscr.io/linuxserver/jellyfin:version-12.2ubu2604",
      "isMain": true,
      "internalPort": 8096,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "JELLYFIN_PublishedServerUrl",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}/"
        }
      ],
      "devices": [
        "/dev/dma_heap:/dev/dma_heap",
        "/dev/mali0:/dev/mali0",
        "/dev/rga:/dev/rga",
        "/dev/mpp_service:/dev/mpp_service",
        "/dev/dri:/dev/dri"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data",
          "containerPath": "/media/data"
        },
        {
          "type": "bind",
          "hostPath": "/mnt/usb-hub",
          "containerPath": "/usb",
          "bind": {
            "propagation": "rslave"
          },
          "readOnly": false
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}