{
  "services": [
    {
      "name": "mattermost",
      "image": "ngrie/mattermost-team-edition-arm:10.11.2",
      "isMain": true,
      "dependsOn": [
        "postgres"
      ],
      "internalPort": 8065,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ:-Asia/Kolkata}"
        },
        {
          "key": "MM_SQLSETTINGS_DRIVERNAME",
          "value": "postgres"
        },
        {
          "key": "MM_SQLSETTINGS_DATASOURCE",
          "value": "postgres://mmuser:mmuser_password@postgres:5432/mattermost?sslmode=disable&connect_timeout=10"
        },
        {
          "key": "MM_BLEVESETTINGS_INDEXDIR",
          "value": "/mattermost/bleve-indexes"
        },
        {
          "key": "MM_SERVICESETTINGS_SITEURL",
          "value": "https://${APP_DOMAIN}"
        },
        {
          "key": "MM_SERVICESETTINGS_TRUSTEDPROXYIPHEADER",
          "value": "X-Forwarded-For"
        }
      ],
      "ports": [
        "8065:8065"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/config",
          "containerPath": "/mattermost/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/data",
          "containerPath": "/mattermost/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/logs",
          "containerPath": "/mattermost/logs"
        },
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/plugins",
          "containerPath": "/mattermost/plugins"
        },
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/client/plugins",
          "containerPath": "/mattermost/client/plugins"
        },
        {
          "hostPath": "${APP_DATA_DIR}/mattermost/bleve-indexes",
          "containerPath": "/mattermost/bleve-indexes"
        }
      ],
      "tmpfs": [
        "/tmp"
      ],
      "restart": "unless-stopped",
      "securityOpt": [
        "no-new-privileges:true"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "pids": 200
          }
        }
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16-alpine",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ:-Asia/Kolkata}"
        },
        {
          "key": "POSTGRES_USER",
          "value": "mmuser"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "mmuser_password"
        },
        {
          "key": "POSTGRES_DB",
          "value": "mattermost"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/db",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "securityOpt": [
        "no-new-privileges:true"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "pids": "100"
          }
        }
      }
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}