{
  "services": [
    {
      "name": "postgres",
      "image": "postgres:13-alpine",
      "environment": {
        "TZ": "${TZ:-Asia/Kolkata}",
        "POSTGRES_USER": "mmuser",
        "POSTGRES_PASSWORD": "mmuser_password",
        "POSTGRES_DB": "mattermost"
      },
      "volumes": [
        {
          "host": "${APP_DATA_DIR}/db",
          "container": "/var/lib/postgresql/data"
        }
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 100
    },
    {
      "name": "permissions",
      "image": "busybox:latest",
      "command": "sh -c \"mkdir -p /mattermost/config /mattermost/data /mattermost/logs /mattermost/plugins /mattermost/client/plugins /mattermost/bleve-indexes && chown -R 2000:2000 /mattermost\"",
      "volumes": [
        {
          "host": "${APP_DATA_DIR}/mattermost",
          "container": "/mattermost"
        }
      ],
      "restart": "no"
    },
    {
      "name": "mattermost",
      "image": "ngrie/mattermost-team-edition-arm:10.11.2",
      "depends_on": [
        "postgres",
        "permissions"
      ],
      "environment": {
        "TZ": "${TZ:-Asia/Kolkata}",
        "MM_SQLSETTINGS_DRIVERNAME": "postgres",
        "MM_SQLSETTINGS_DATASOURCE": "postgres://mmuser:mmuser_password@postgres:5432/mattermost?sslmode=disable&connect_timeout=10",
        "MM_BLEVESETTINGS_INDEXDIR": "/mattermost/bleve-indexes",
        "MM_SERVICESETTINGS_SITEURL": "https://${APP_DOMAIN}",
        "MM_SERVICESETTINGS_TRUSTEDPROXYIPHEADER": "X-Forwarded-For"
      },
      "ports": [
        "8065:8065"
      ],
      "volumes": [
        {
          "host": "${APP_DATA_DIR}/mattermost/config",
          "container": "/mattermost/config"
        },
        {
          "host": "${APP_DATA_DIR}/mattermost/data",
          "container": "/mattermost/data"
        },
        {
          "host": "${APP_DATA_DIR}/mattermost/logs",
          "container": "/mattermost/logs"
        },
        {
          "host": "${APP_DATA_DIR}/mattermost/plugins",
          "container": "/mattermost/plugins"
        },
        {
          "host": "${APP_DATA_DIR}/mattermost/client/plugins",
          "container": "/mattermost/client/plugins"
        },
        {
          "host": "${APP_DATA_DIR}/mattermost/bleve-indexes",
          "container": "/mattermost/bleve-indexes"
        }
      ],
      "tmpfs": [
        "/tmp"
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 200,
      "add_tipi_labels": true
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}