{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "frigate",
      "image": "ghcr.io/blakeblackshear/frigate:0.18.2-rk",
      "isMain": true,
      "internalPort": 8971,
      "networkMode": "host",
      "privileged": true,
      "shmSize": "536870912",
      "stopGracePeriod": "30s",
      "devices": [
        "/dev/dri",
        "/dev/dma_heap",
        "/dev/video-dec0",
        "/dev/video-enc0",
        "/dev/rga",
        "/dev/mpp_service"
      ],
      "ports": [
        {
          "hostPort": 5000,
          "containerPort": 5000
        }
      ],
      "environment": [
        { 
          "key": "TZ", 
          "value": "${TZ}" 
        },
        { 
          "key": "FRIGATE_JWT_SECRET", 
          "value": "${FRIGATE_JWT_SECRET}" 
        }
      ],
      "volumes": [
        {
          "hostPath": "/sys",
          "containerPath": "/sys",
          "readOnly": true
        },
        {
          "hostPath": "/etc/localtime",
          "containerPath": "/etc/localtime",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/media/frigate"
        },
        {
          "hostPath": "/mnt/frigate_cache",
          "containerPath": "/tmp/cache"
        }
      ]
    }
  ]
}