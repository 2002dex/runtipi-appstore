{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/dynamic-compose.json",
  "services": [
    {
      "name": "homeassistant",
      "image": "ghcr.io/home-assistant/home-assistant:2026.7",
      "internalPort": 8123,
      "isMain": true,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/localtime",
          "containerPath": "/etc/localtime",
          "readOnly": true
        },
        {
          "hostPath": "/run/dbus",
          "containerPath": "/run/dbus"
        }
      ],
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "restart": "unless-stopped",
      "depends_on": ["matter-server"]
    },
    {
      "name": "matter-server",
      "image": "ghcr.io/matter-js/matterjs-server:1.1.7",
      "networkMode": "host",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/matter-server",
          "containerPath": "/data"
        }
      ],
      "restart": "unless-stopped"
    }
  ]
}